# Copy to .env.local only if that file does not already exist.
# Never use VITE_ for secrets. Process environment takes precedence.
GEMINI_API_KEY=""
GEMINI_TEXT_MODEL="gemini-3.5-flash"
# Shared hourly ceiling across Kavi and AI songwriting (10–10,000).
GEMINI_GLOBAL_REQUESTS_PER_HOUR="240"
PORT="3000"

# false for localhost HTTP. Set true only when serving through HTTPS.
COOKIE_SECURE="false"

# Public HTTPS origin used for canonical, social and sitemap URLs when deployed.
# Example: https://soundproof-music-studio.onrender.com (no trailing slash)
PUBLIC_SITE_URL=""

# Optional social sign-in. Email/studio-name + password always remains available.
# Google Web OAuth client; localhost callback:
# http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Sign in with Apple for a deployed HTTPS domain only. APPLE_CLIENT_ID is the
# Services ID. Keep the .p8 private key on one line using literal \n characters.
# Deployed callback: https://YOUR-DOMAIN/api/auth/apple/callback
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# Optional WebRTC ICE configuration. Empty uses the demo STUN default.
# Some networks require your own TURN service; use one-line RTCIceServer JSON.
PHONE_MIC_ICE_SERVERS=""

